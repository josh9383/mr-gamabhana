<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.description }}">
    <link rel="canonical" href="{{ site.base_url }}/">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css">
    <link rel="stylesheet" href="{{ site.theme_stylesheet }}">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/tom-select.bootstrap5.min.css">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-primary sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ site.base_url }}/">{{ site.title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSections" aria-controls="navbarSections" aria-expanded="true" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navbarSections" style="">
                <ul class="navbar-nav me-auto">
                    {% for key, title, path_name in menu_groups %}
                    <li class="nav-item" >
                        <a class="nav-link" href="{{ site.base_url }}/{{ path_name }}/">{{ title }}</a>
                    </li>
                    {% endfor %}
                </ul>
                <div class="search ms-auto">
                    <div class="input-group">
                        <span class="input-group-text" id="search-icon">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </span>
                         <input id="search-input" type="search" class="form-control phonetic-input" placeholder="शोधा..." autocomplete="off" aria-label="शोधा">
                    </div>
                    <div id="autosuggest" class="autosuggest" hidden></div>
                </div>
            </div>
        </div>
    </nav>

<main class="container container-fluid py-4">
    <div class="facets row justify-content-center">
            {% for type, label in facet_groups %}
            <div class="col-4 col-md-2 facet" data-facet="{{ type }}" data-label="{{ label }}">
                <select class="form-select facet-select" multiple aria-label="{{ label }}"></select>
            </div>
            {% endfor %}
            <div class="col-4 col-md-2 facet-actions">
                <button id="clear-facets" type="button" class="btn btn-sm"><i class="fa-solid fa-rotate"></i></button>
            </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <h1 class="h2">{{ site.title }}</h1>
            <p class="lead">{{ site.description }}</p>

            <div id="search-page" data-base-url="{{ site.base_url }}">
                <p id="result-count" class="result-count"></p>
                <div id="search-results" class="catalogue-grid"></div>
                <div id="search-more" aria-live="polite"></div>
            </div>
        </div>
    </div>
</main>

<script src="{{ site.bootstrap_script }}"></script>
<script src="{{ site.base_url }}/assets/minisearch.min.js"></script>
<script src="{{ site.base_url }}/assets/tom-select.min.js"></script>
<script src="{{ site.base_url }}/assets/app.js"></script>
<!--script differ src="https://www.gamabhana.com/gamabhanaWidget/?mode=custom&l=0&k=1&n=&c=phonetic-input" ></script-->
</body>
</html>
