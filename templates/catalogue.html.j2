<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css">
    <link rel="stylesheet" href="{{ site.theme_stylesheet }}">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/tom-select.bootstrap5.min.css">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/style.css">
    <link rel="shortcut icon" type="image/x-icon" href="{{ site.base_url }}/assets/{{ site.favicon }}">

<meta property="og:title" content="{{ title }} | {{ site.title }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:url" content="{{ canonical_url }}" />

<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y297t705sz");
</script>
</head>
<body>
{% macro card(item) %}
<div class="card catalogue-card" data-search="{{ item.search }}">
    {% if not item.image_urls or item.image_urls|length == 0 %}
    <img class="card-img-top" src="{{ site.base_url }}/assets/card-fallback.png" alt="{{ item.title }}">
    {% elif item.image_urls|length == 1 %}
    <img class="card-img-top" src="{{ site.base_url }}{{ item.image_urls[0] }}" alt="{{ item.title }}">
    {% else %}
    {% set num_images = item.image_urls|length if item.image_urls|length <= 6 else 6 %}
    <div class="card-carousel card-carousel--{{ num_images }}">
        {% for img_url in item.image_urls[:6] %}
        <img src="{{ site.base_url }}{{ img_url }}" alt="{{ item.title }}" loading="lazy">
        {% endfor %}
    </div>
    {% endif %}
    <div class="card-body">
        <h2 class="card-title h5"><a class="text-decoration-none" href="{{ item.url }}" >{{ item.title }}</a></h2>
        {% if item.description %}<p class="card-text">{{ item.description }}</p>{% endif %}
    </div>
    {% if item.count is not none %}
    <div class="card-footer">
        <small>युक्त्या ({{ item.count }})</small>
    </div>
    {% elif item.footer_badges %}
    <div class="card-footer d-flex flex-wrap gap-1">
        {% for badge in item.footer_badges %}
        <a class="badge badge-{{ badge.url.split('/')[1] }} text-decoration-none" href="{{ site.base_url }}{{ badge.url }}">{{ badge.value }}</a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endmacro %}

<nav class="navbar navbar-expand-lg bg-primary sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
          {% if site.logo %}
            <a class="navbar-brand" href="{{ site.base_url }}/"><img src="{{ site.base_url }}/assets/{{ site.logo }}" alt="{{ site_title }}" height="28"></a>
          {% else %}
            <a class="navbar-brand" href="{{ site.base_url }}/">{{ site.title }}</a>
          {% endif %}

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSections" aria-controls="navbarSections" aria-expanded="true" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navbarSections" style="">
                <ul class="navbar-nav me-auto">
                {% for key, title, path_name in menu_groups %}
                    <li class="nav-item" >
                        <a class="nav-link" href="{{ site.base_url }}/{{ path_name }}/">{{ title }}</a>
                    </li>
                    {% endfor %}
                </ul>
                <div class="search ms-auto">
                    <div class="input-group">
                        <span class="input-group-text" id="search-icon">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </span>
                         <input id="search-input" type="search" class="{% if not locked_facet and not search_index %}catalogue-search {% endif %}form-control phonetic-input" placeholder="शोधा..." autocomplete="off" aria-label="शोधा">
                    </div>
                    <div id="autosuggest" class="autosuggest" hidden></div>
                </div>
            </div>
        </div>
</nav>

<main class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ site.base_url }}/">गमभन</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
        </ol>
    </nav>

    <h1 class="h2">{{ title }}</h1>
    <p class="lead">{{ description }}</p>

    {% if locked_facet or search_index %}
    <div class="facets row justify-content-center">
            {% for type, label in facet_groups %}
            {% if locked_facet and type == locked_facet.type %}
            <div class="col-4 col-md-2 facet" data-facet="{{ type }}" data-label="{{ label }}" data-locked="true">
                {% for value in locked_facet['values'] %}
                <input type="text" class="form-control" value="{{ value }}" disabled readonly>
                {% endfor %}
            </div>
            {% else %}
            <div class="col-4 col-md-2 facet" data-facet="{{ type }}" data-label="{{ label }}">
                <select class="form-select facet-select" multiple aria-label="{{ label }}"></select>
            </div>
            {% endif %}
            {% endfor %}
            <div class="col-4 col-md-2 facet-actions">
                <button id="clear-facets" type="button" class="btn btn-sm"><i class="fa-solid fa-rotate"></i></button>
            </div>
    </div>

    <div id="search-page" data-base-url="{{ site.base_url }}" data-meta-url="{{ site.base_url }}/meta.json"{% if search_index %} data-index="{{ search_index }}"{% endif %}{% if locked_facet %} data-locked-facet="{{ locked_facet.type }}" data-locked-values='{{ locked_facet['values'] | tojson }}'{% endif %}>
        <p id="result-count" class="result-count"></p>
        <div id="search-results" class="catalogue-grid">
            {% for item in items %}
            {{ card(item) }}
            {% endfor %}
        </div>
        <div id="search-more" aria-live="polite"></div>
    </div>
    {% else %}
    <div class="catalogue-grid" id="catalogue-list">
        {% for item in items %}
        {{ card(item) }}
        {% endfor %}
    </div>
    {% endif %}
</main>

<script src="{{ site.bootstrap_script }}"></script>
<script src="{{ site.base_url }}/assets/minisearch.min.js"></script>
<script src="{{ site.base_url }}/assets/tom-select.min.js"></script>
<script src="{{ site.base_url }}/assets/app.js"></script>
</body>
</html>
