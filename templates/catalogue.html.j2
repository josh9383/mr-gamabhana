<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="stylesheet" href="{{ site.theme_stylesheet }}">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/style.css">
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" href="{{ site.base_url }}/">{{ site.title }}</a>
    </div>
</nav>

<main class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ site.base_url }}/">गमभन</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
        </ol>
    </nav>

    <h1 class="h2">{{ title }}</h1>
    <p class="lead">{{ description }}</p>

    <div class="search mb-4">
        <input class="catalogue-search form-control phonetic-input" type="search" placeholder="शोधा...">
    </div>

    <div class="catalogue-grid" id="catalogue-list">
        {% for item in items %}
        <div class="card catalogue-card"  data-search="{{ item.search }}">
            {% if not item.image_urls or item.image_urls|length == 0 %}
            <img class="card-img-top" src="{{ site.base_url }}/assets/card-fallback.png" alt="{{ item.title }}">
            {% elif item.image_urls|length == 1 %}
            <img class="card-img-top" src="{{ site.base_url }}{{ item.image_urls[0] }}" alt="{{ item.title }}">
            {% else %}
            {% set num_images = item.image_urls|length if item.image_urls|length <= 6 else 6 %}
            <div class="card-carousel card-carousel--{{ num_images }}">
                {% for img_url in item.image_urls[:6] %}
                <img src="{{ site.base_url }}{{ img_url }}" alt="{{ item.title }}" loading="lazy">
                {% endfor %}
            </div>
            {% endif %}
            <div class="card-body">
                <h2 class="card-title h5"><a class="text-decoration-none" href="{{ item.url }}" >{{ item.title }}</a></h2>
                {% if item.description %}<p class="card-text">{{ item.description }}</p>{% endif %}
            </div>
            {% if "props" in catalogue_attributes and item.props %}
            <div class="card-footer d-flex flex-wrap gap-1">
                {% for prop in item.props %}
                <a class="badge text-bg-light text-decoration-none" href="{{ site.base_url }}/props/{{ item.prop_slugs[loop.index0] }}/">{{ prop }}</a>
                {% endfor %}
            </div>
            {% elif item.count is not none %}
            <div class="card-footer">
                <small>युक्त्या ({{ item.count }})</small>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</main>

<script src="{{ site.bootstrap_script }}"></script>
<script src="{{ site.base_url }}/assets/minisearch.min.js"></script>
<script src="{{ site.base_url }}/assets/app.js"></script>
<script differ src="https://www.gamabhana.com/gamabhanaWidget/?mode=custom&l=0&k=1&n=&c=phonetic-input" ></script>
</body>
</html>
