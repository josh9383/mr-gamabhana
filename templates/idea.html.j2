<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ site.base_url }}/ideas/{{ id }}/">
    <link rel="stylesheet" href="{{ site.theme_stylesheet }}">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/style.css">
    <link rel="shortcut icon" type="image/x-icon" href="{{ site.base_url }}/assets/{{ site.favicon }}">

<meta property="og:title" content="{{ title }} | {{ site.title }}" />
<meta property="og:description" content="{{ title }} | {{ site.title }}" />
<meta property="og:image" content="{{ site.base_url }}{{ image_urls | first }}" />
<meta property="og:url" content="{{ site.base_url }}/ideas/{{ id }}/" />

<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y297t705sz");
</script>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-primary sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
          {% if site.logo %}
            <a class="navbar-brand" href="{{ site.base_url }}/"><img src="{{ site.base_url }}/assets/{{ site.logo }}" alt="{{ site_title }}" height="28"></a>
          {% else %}
            <a class="navbar-brand" href="{{ site.base_url }}/">{{ site.title }}</a>
          {% endif %}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSections" aria-controls="navbarSections" aria-expanded="true" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navbarSections" style="">
                <ul class="navbar-nav me-auto">
                {% for key, title, path_name in menu_groups %}
                    <li class="nav-item" >
                        <a class="nav-link" href="{{ site.base_url }}/{{ path_name }}/">{{ title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
</nav>
<div class="watermark-overlay"></div>
<main class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ site.base_url }}/">गमभन</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
        </ol>
    </nav>

    <div class="card idea-page-card">
        <div class="card-body">
            <header>
                <h1 class="h2">{{ title }}</h1>
                {% if description %}<p class="lead">{{ description }}</p>{% endif %}
            </header>

            {% if not image_urls or image_urls|length == 0 %}
            <img class="card-img-top" src="{{ site.base_url }}/assets/card-fallback.png" alt="{{ title }}">
            {% elif image_urls|length == 1 %}
            <img class="card-img-top" src="{{ site.base_url }}{{ image_urls[0] }}" alt="{{ title }}">
            {% else %}
            {% set num_images = image_urls|length if image_urls|length <= 6 else 6 %}
            <div class="card-carousel card-carousel--{{ num_images }}">
                {% for img_url in image_urls[:6] %}
                <img src="{{ site.base_url }}{{ img_url }}" alt="{{ title }}" loading="lazy">
                {% endfor %}
            </div>
            {% endif %}

            {% if not audio_urls or audio_urls|length == 0 %}
                <!-- no audio -->
            {% else %}
            {% set num_tracks = audio_urls|length if audio_urls|length <= 6 else 6 %}
            <div class="row audio-tracks">
                {% for audio_url in audio_urls[:6] %}
                <div class="col" ><audio controls src="{{ site.base_url }}{{ audio_url }}" alt="{{ title }}" loading="lazy" ></audio></div>
                {% endfor %}
            </div>
            {% endif %}

            <div class="idea-content mt-3">{{ content_html }}</div>
        </div>
        {% if footer_badges %}
        <div class="card-footer d-flex flex-wrap gap-1">
            {% for badge in footer_badges %}
            <a class="badge badge-{{ badge.url.split('/')[1] }} text-decoration-none" href="{{ site.base_url }}{{ badge.url }}">{{ badge.value }}</a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</main>

<script src="{{ site.bootstrap_script }}"></script>
<script src="{{ site.base_url }}/assets/app.js"></script>
</body>
</html>
