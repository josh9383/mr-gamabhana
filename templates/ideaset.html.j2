<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ site.title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="stylesheet" href="{{ site.theme_stylesheet }}">
    <link rel="stylesheet" href="{{ site.base_url }}/assets/style.css">
    <link rel="shortcut icon" type="image/x-icon" href="{{ site.base_url }}/assets/{{ site.favicon }}">

<meta property="og:title" content="{{ title }} | {{ site.title }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:url" content="{{ canonical_url }}" />
<meta property="og:image" content="{{ site.base_url }}/assets/{{ site.og_logo }}" />

<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "y297t705sz");
</script>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-primary sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
          {% if site.logo %}
            <a class="navbar-brand" href="{{ site.base_url }}/"><img src="{{ site.base_url }}/assets/{{ site.logo }}" alt="{{ site_title }}" height="28"></a>
          {% else %}
            <a class="navbar-brand" href="{{ site.base_url }}/">{{ site.title }}</a>
          {% endif %}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSections" aria-controls="navbarSections" aria-expanded="true" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navbarSections" style="">
                <ul class="navbar-nav me-auto">
                {% for key, title, path_name in menu_groups %}
                    <li class="nav-item" >
                        <a class="nav-link" href="{{ site.base_url }}/{{ path_name }}/">{{ title }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
</nav>
<div class="watermark-overlay"></div>
<main class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ site.base_url }}/">गमभन</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
        </ol>
    </nav>

    <h1 class="h2">{{ title }}</h1>
    <p class="lead">{{ items|length }} युक्त्या</p>

    <div id="ideaset-cards">
        {% for item in items %}
        <div class="card ideaset-card{% if not loop.first %} card-hidden{% endif %}">
            <div class="card-body">
                <h2 class="card-title h5"><a class="text-decoration-none" href="{{ item.url }}">{{ item.title }}</a></h2>
                {% if item.description %}<p class="card-text">{{ item.description }}</p>{% endif %}

                {% if not item.image_urls or item.image_urls|length == 0 %}
                <img class="card-img-top" src="{{ site.base_url }}/assets/card-fallback.png" alt="{{ item.title }}">
                {% elif item.image_urls|length == 1 %}
                <img class="card-img-top" src="{{ site.base_url }}{{ item.image_urls[0] }}" alt="{{ item.title }}">
                {% else %}
                {% set num_images = item.image_urls|length if item.image_urls|length <= 6 else 6 %}
                <div class="card-carousel card-carousel--{{ num_images }}">
                    {% for img_url in item.image_urls[:6] %}
                    <img src="{{ site.base_url }}{{ img_url }}" alt="{{ item.title }}" loading="lazy">
                    {% endfor %}
                </div>
                {% endif %}

                <div class="idea-content mt-3">{{ item.content_html }}</div>
            </div>
            {% if item.footer_badges %}
            <div class="card-footer d-flex flex-wrap gap-1">
                {% for badge in item.footer_badges %}
                <a class="badge badge-{{ badge.url.split('/')[1] }} text-decoration-none" href="{{ site.base_url }}{{ badge.url }}">{{ badge.value }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    <div id="ideaset-more" aria-live="polite"></div>
</main>

<script src="{{ site.bootstrap_script }}"></script>
<script src="{{ site.base_url }}/assets/app.js"></script>
</body>
</html>
